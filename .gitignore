# The notes editor bundle is deployed from Flask's static directory.
!static/js/notes/dist/
static/js/notes/dist/*
!static/js/notes/dist/notes-editor-v*.js
!static/js/notes/dist/notes-editor-*.woff
!static/js/notes/dist/notes-editor-*.woff2

# The Tasks application is bundled locally so runtime framework CDNs are unnecessary.
!static/js/tasks/dist/
static/js/tasks/dist/*
!static/js/tasks/dist/task-app.js

# The classic-script Sortable bridge is built locally from the pinned npm package.
!static/js/vendor/dist/
static/js/vendor/dist/*
!static/js/vendor/dist/sortable-global.js

